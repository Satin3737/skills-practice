{
    "name": "nest-demo",
    "version": "1.0.0",
    "description": "nest-demo",
    "author": "satin",
    "private": true,
    "license": "ISC",
    "scripts": {
        "dev": "pnpm run start:dev",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "oxlint --fix src test",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
    },
    "dependencies": {
        "@nestjs/common": "^12.1.1",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^12.1.1",
        "@nestjs/mapped-types": "*",
        "@nestjs/platform-express": "^12.1.1",
        "@nestjs/swagger": "^12.0.2",
        "@nestjs/typeorm": "^12.0.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "mysql2": "^3.24.4",
        "rxjs": "^7.8.2",
        "typeorm": "^1.1.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.8",
        "@nestjs/schematics": "^12.0.6",
        "@nestjs/testing": "^12.1.1",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.3",
        "@types/supertest": "^7.2.1",
        "jest": "^30.5.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.3.0",
        "ts-jest": "^29.4.14",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/$1"
        }
    }
}
