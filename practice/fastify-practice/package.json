{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "fastify-practice",
    "version": "1.0.0",
    "main": "dist/app.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/app.ts",
        "build": "pnpm oxlint . && tsc && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "start": "node dist/app.js",
        "worker:email": "tsx watch src/workers/processes/email.ts",
        "test": "tsx scripts/setup-test-db.ts && NODE_OPTIONS=--import=tsx vitest run",
        "test:watch": "tsx scripts/setup-test-db.ts && NODE_OPTIONS=--import=tsx vitest",
        "db:generate": "pnpm dlx prisma generate",
        "db:migrate": "pnpm dlx prisma migrate dev",
        "db:create-migration": "pnpm dlx prisma migrate dev --create-only",
        "db:migrate-deploy": "pnpm dlx prisma migrate deploy",
        "db:status": "pnpm dlx prisma migrate status",
        "db:studio": "pnpm dlx prisma studio",
        "db:seed": "tsx prisma/seed.ts"
    },
    "author": "satin",
    "license": "ISC",
    "description": "fastify practice",
    "dependencies": {
        "@anthropic-ai/sdk": "^0.119.0",
        "@fastify/autoload": "^6.5.0",
        "@fastify/cookie": "^11.1.2",
        "@fastify/cors": "^11.3.0",
        "@fastify/env": "^7.0.0",
        "@fastify/helmet": "^13.1.1",
        "@fastify/jwt": "^10.2.2",
        "@fastify/oauth2": "^8.3.0",
        "@fastify/rate-limit": "^11.2.0",
        "@fastify/redis": "^9.0.0",
        "@fastify/schedule": "^7.0.0",
        "@fastify/sensible": "^6.0.5",
        "@fastify/swagger": "^9.8.1",
        "@fastify/swagger-ui": "^6.1.1",
        "@fastify/websocket": "^11.3.0",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "@zrosenbauer/fastify-prisma": "^7.0.2",
        "bullmq": "^6.1.2",
        "fastify": "^5.12.1",
        "fastify-cli": "^8.0.0",
        "fastify-plugin": "^6.0.0",
        "fastify-type-provider-zod": "^7.0.0",
        "ioredis": "^6.0.0",
        "nodemailer": "^9.0.5",
        "pg": "^8.23.0",
        "pino": "^10.3.1",
        "pm2": "^7.0.3",
        "toad-scheduler": "^4.1.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.23.1",
        "@types/ws": "^8.18.1",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.9.1",
        "prisma-zod-generator": "^3.3.0",
        "tsc-alias": "^1.9.2",
        "vitest": "^4.1.11"
    }
}
